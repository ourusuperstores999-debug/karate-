<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JobFee · apply with confidence</title>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
        }

        body {
            background: linear-gradient(145deg, #f8faff 0%, #eef2f9 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem 1rem;
        }

        .app-container {
            max-width: 1200px;
            width: 100%;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(8px);
            border-radius: 3rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), inset 0 1px 2px rgba(255,255,255,0.7);
            padding: 2rem 2rem 3rem;
            border: 1px solid rgba(255,255,255,0.5);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .logo h1 {
            font-size: 2.2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1e2b4f, #2d3f6e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: #3b5bdb;
            font-weight: 800;
            background: none;
            -webkit-text-fill-color: #3b5bdb;
        }

        .fee-badge {
            background: #1e2b4f;
            color: white;
            padding: 0.6rem 1.2rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 10px 15px -5px rgba(30, 43, 79, 0.3);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .fee-badge i {
            color: #fcc419;
        }

        .job-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.8rem;
            margin-bottom: 3rem;
        }

        .job-card {
            background: white;
            border-radius: 1.8rem;
            padding: 1.8rem 1.5rem 1.5rem;
            box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.1);
            transition: transform 0.25s ease, box-shadow 0.3s ease;
            border: 1px solid #ffffff50;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .job-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 35px -10px rgba(30, 43, 79, 0.2);
        }

        .job-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, #3b5bdb, #6b8cff);
        }

        .job-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .company-icon {
            background: #eef2ff;
            color: #3b5bdb;
            width: 50px;
            height: 50px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .job-title {
            font-weight: 700;
            font-size: 1.3rem;
            color: #0f1a2e;
            line-height: 1.3;
        }

        .company-name {
            font-size: 0.9rem;
            color: #5a6b8a;
            font-weight: 500;
            margin-top: 2px;
        }

        .job-desc {
            color: #334155;
            font-size: 0.95rem;
            line-height: 1.5;
            margin: 0.8rem 0 1.2rem;
            flex: 1;
        }

        .job-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            flex-wrap: wrap;
            gap: 10px;
        }

        .salary {
            background: #f1f5f9;
            padding: 0.35rem 0.9rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #1e2b4f;
        }

        .apply-btn {
            background: linear-gradient(135deg, #1e2b4f, #2d3f6e);
            border: none;
            color: white;
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 10px 15px -5px #1e2b4f50;
            width: 100%;
            justify-content: center;
        }

        .apply-btn i {
            font-size: 0.9rem;
        }

        .apply-btn:hover:not(:disabled) {
            background: #2b3b64;
            transform: scale(1.02);
            box-shadow: 0 15px 20px -8px #1e2b4f70;
        }

        .apply-btn:disabled {
            background: #b0bedb;
            cursor: not-allowed;
            box-shadow: none;
            opacity: 0.8;
        }

        .apply-btn.paid {
            background: #2e7d5e;
        }

        .apply-btn.paid:disabled {
            background: #7fa395;
        }

        .payment-note {
            font-size: 0.8rem;
            color: #64748b;
            text-align: center;
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .payment-note i {
            color: #3b5bdb;
        }

        .toast-message {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) scale(0.9);
            background: #1e2b4f;
            color: white;
            padding: 1rem 2rem;
            border-radius: 60px;
            font-weight: 500;
            box-shadow: 0 20px 30px -10px black;
            opacity: 0;
            transition: opacity 0.2s, transform 0.2s;
            pointer-events: none;
            z-index: 999;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1rem;
            border: 1px solid #ffffff30;
            backdrop-filter: blur(8px);
        }

        .toast-message.show {
            opacity: 1;
            transform: translateX(-50%) scale(1);
            pointer-events: auto;
        }

        .toast-message i {
            color: #4ade80;
            font-size: 1.2rem;
        }

        .stats-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #ffffffb0;
            backdrop-filter: blur(5px);
            padding: 1rem 2rem;
            border-radius: 60px;
            margin-top: 1.5rem;
            border: 1px solid #ffffff;
            flex-wrap: wrap;
            gap: 15px;
        }

        .stats-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 500;
            color: #1e2b4f;
        }

        .stats-item i {
            color: #3b5bdb;
            font-size: 1.2rem;
        }

        .payment-preview {
            background: #1e2b4f0d;
            padding: 0.8rem 1.2rem;
            border-radius: 40px;
            font-size: 0.9rem;
            font-weight: 500;
            color: #1e2b4f;
        }

        @media (max-width: 600px) {
            .app-container {
                padding: 1.5rem 1rem;
                border-radius: 2rem;
            }
            .header {
                flex-direction: column;
                align-items: start;
            }
            .toast-message {
                width: 90%;
                white-space: normal;
                text-align: center;
            }
            .job-card {
                padding: 1.5rem 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- Header -->
        <div class="header">
            <div class="logo">
                <h1>Job<span>Fee</span> <i class="fas fa-briefcase" style="color: #3b5bdb; font-size: 1.8rem;"></i></h1>
                <p style="color: #4a5c7c; font-size: 0.9rem; margin-top: 4px;">Apply smarter · pay once per job</p>
            </div>
            <div class="fee-badge">
                <i class="fas fa-tag"></i> $10 application fee
            </div>
        </div>

        <!-- Job Grid -->
        <div class="job-grid" id="jobGrid">
            <!-- Job cards will be rendered by JavaScript -->
        </div>

        <!-- Stats & bottom bar -->
        <div class="stats-bar">
            <div class="stats-item">
                <i class="fas fa-check-circle"></i>
                <span id="appliedCount">0</span> jobs applied
            </div>
            <div class="stats-item">
                <i class="fas fa-wallet"></i>
                <span>Total spent: $<span id="totalSpent">0</span></span>
            </div>
            <div class="payment-preview">
                <i class="fas fa-lock" style="margin-right: 6px;"></i> Demo payment · $10 per application
            </div>
        </div>
    </div>

    <!-- Toast notification -->
    <div class="toast-message" id="toast">
        <i class="fas fa-check-circle"></i>
        <span id="toastText">Payment successful! Application submitted.</span>
    </div>

    <script>
        // ---------- Data (simulated backend / job list) ----------
        const JOBS = [
            { id: 1, title: 'Frontend Developer', company: 'Innovate Labs', desc: 'Build modern UIs with React & TypeScript. 2+ years of experience.', salary: '$110k – $130k', icon: 'fa-code' },
            { id: 2, title: 'Backend Engineer', company: 'CloudSphere', desc: 'Node.js, PostgreSQL, AWS. Design scalable APIs and microservices.', salary: '$120k – $145k', icon: 'fa-server' },
            { id: 3, title: 'Product Designer', company: 'PixelCraft', desc: 'UI/UX design, Figma, prototyping. Shape user experiences end-to-end.', salary: '$95k – $115k', icon: 'fa-paint-brush' },
            { id: 4, title: 'Data Analyst', company: 'InsightFlow', desc: 'SQL, Python, dashboards. Turn data into actionable insights.', salary: '$85k – $105k', icon: 'fa-chart-line' },
            { id: 5, title: 'DevOps Specialist', company: 'ServerWave', desc: 'Kubernetes, CI/CD, Terraform. Automate and scale infrastructure.', salary: '$130k – $150k', icon: 'fa-cogs' },
            { id: 6, title: 'Full Stack Developer', company: 'NovaSoft', desc: 'MERN stack, end-to-end feature development. Fast-paced startup.', salary: '$115k – $135k', icon: 'fa-laptop-code' }
        ];

        // Global state
        let userPaidJobs = new Set();       // store job ids that have been paid+applied
        let totalSpent = 0;

        // ---------- DOM elements ----------
        const jobGrid = document.getElementById('jobGrid');
        const toast = document.getElementById('toast');
        const toastText = document.getElementById('toastText');
        const appliedCountSpan = document.getElementById('appliedCount');
        const totalSpentSpan = document.getElementById('totalSpent');

        // ---------- Helper: show toast message ----------
        let toastTimeout;
        function showToast(message, isError = false) {
            toastText.textContent = message;
            toast.classList.add('show');
            toast.style.background = isError ? '#9b2c2c' : '#1e2b4f';
            // change icon if error (optional)
            const icon = toast.querySelector('i');
            if (isError) {
                icon.className = 'fas fa-exclamation-circle';
            } else {
                icon.className = 'fas fa-check-circle';
            }
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 2800);
        }

        // ---------- Update stats UI ----------
        function updateStats() {
            appliedCountSpan.textContent = userPaidJobs.size;
            totalSpentSpan.textContent = totalSpent;
        }

        // ---------- Simulate backend payment processing (mock) ----------
        // This returns a promise that resolves after a short delay.
        // In a real app, you would call a payment gateway (Stripe, PayPal) and a backend endpoint.
        function processPayment(jobId, amount = 10) {
            return new Promise((resolve, reject) => {
                // simulate network request
                setTimeout(() => {
                    // 95% success rate for demo (but we always succeed unless amount invalid)
                    if (amount === 10) {
                        // In real backend: charge card, verify, then record application.
                        // Here we just resolve with a mock transaction id.
                        resolve({ success: true, transactionId: 'tx_' + Math.random().toString(36).substring(2, 12) });
                    } else {
                        reject(new Error('Invalid amount'));
                    }
                }, 800);
            });
        }

        // ---------- Handle apply button click ----------
        async function handleApply(jobId, buttonElement) {
            // If already applied, do nothing (button should be disabled)
            if (userPaidJobs.has(jobId)) {
                showToast('You have already applied for this job.', true);
                return;
            }

            // Disable button and show loading state
            const originalText = buttonElement.innerHTML;
            buttonElement.disabled = true;
            buttonElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing $10...';

            try {
                // simulate $10 payment (mock backend)
                const paymentResult = await processPayment(jobId, 10);
                
                // If we get here, payment succeeded
                if (paymentResult.success) {
                    // Mark job as applied/paid
                    userPaidJobs.add(jobId);
                    totalSpent += 10;
                    
                    // Update button permanently to "Applied ✓"
                    buttonElement.innerHTML = '<i class="fas fa-check-circle"></i> Applied ✓';
                    buttonElement.classList.add('paid');
                    buttonElement.disabled = true;  // keep disabled forever
                    
                    // Update stats panel
                    updateStats();
                    
                    // Show success toast with transaction info
                    showToast(`Payment of $10 successful! Application submitted.`, false);
                    
                    // In a real backend, you would also send application data to server here.
                    console.log(`[BACKEND SIM] Job ${jobId} applied, $10 charged. TX: ${paymentResult.transactionId}`);
                } else {
                    throw new Error('Payment failed');
                }
            } catch (error) {
                console.error('Payment error:', error);
                // Re-enable button, restore text
                buttonElement.disabled = false;
                buttonElement.innerHTML = originalText;
                showToast('Payment failed. Please try again.', true);
            }
        }

        // ---------- Render job cards ----------
        function renderJobs() {
            jobGrid.innerHTML = ''; // clear

            JOBS.forEach(job => {
                const isApplied = userPaidJobs.has(job.id);
                
                const card = document.createElement('div');
                card.className = 'job-card';
                card.dataset.jobId = job.id;

                // Build inner HTML
                card.innerHTML = `
                    <div class="job-header">
                        <div class="company-icon">
                            <i class="fas ${job.icon}"></i>
                        </div>
                        <div>
                            <div class="job-title">${job.title}</div>
                            <div class="company-name">${job.company}</div>
                        </div>
                    </div>
                    <div class="job-desc">${job.desc}</div>
                    <div class="job-meta">
                        <span class="salary"><i class="fas fa-dollar-sign" style="margin-right: 4px;"></i>${job.salary}</span>
                    </div>
                    <button class="apply-btn" data-job-id="${job.id}" ${isApplied ? 'disabled' : ''}>
                        ${isApplied ? '<i class="fas fa-check-circle"></i> Applied ✓' : '<i class="fas fa-lock-open"></i> Apply · $10'}
                    </button>
                    <div class="payment-note">
                        <i class="fas fa-shield-alt"></i> Secure $10 application fee
                    </div>
                `;

                // If already paid, add class
                if (isApplied) {
                    const btn = card.querySelector('.apply-btn');
                    btn.classList.add('paid');
                }

                jobGrid.appendChild(card);
            });

            // Attach event listeners to all apply buttons (except disabled ones — but we listen anyway and check)
            document.querySelectorAll('.apply-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const jobId = parseInt(btn.dataset.jobId, 10);
                    // If button is already disabled (applied), just return
                    if (btn.disabled) return;
                    handleApply(jobId, btn);
                });
            });
        }

        // ---------- Initialize ----------
        function init() {
            // Load from localStorage? (optional; we keep in memory only for simplicity)
            // But we can simulate some persistent state if needed. Not necessary.
            renderJobs();
            updateStats();
        }

        init();

        // (Optional) simulate a mock backend response for any other needs
        // but the processPayment function above acts as the backend.
    </script>
</body>
</html>
